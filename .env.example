# Database
DATABASE_URL=postgresql://tyf:tyf_dev_password@localhost:5432/track_your_future

# Auth (NextAuth v5)
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tyf-documents
MINIO_USE_SSL=false

# Billing provider: stripe or polar
BILLING_PROVIDER=stripe

# Stripe (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Polar (required when BILLING_PROVIDER=polar)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_ANNUAL=

# AI Providers (at least one required; OpenAI or Mistral)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@trackedyourfuture.com

# Cron
CRON_SECRET=generate-with-openssl-rand-base64-32
