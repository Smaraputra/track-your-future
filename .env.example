# Database
DATABASE_URL=postgresql://tyf:tyf_dev_password@localhost:5432/track_your_future

# Auth (NextAuth v5)
# Use PORT=3001 for local dev to avoid port conflicts
AUTH_URL=http://localhost:3001
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tyf-documents
MINIO_USE_SSL=false

# Billing: set to "true" to give all users Pro access without Stripe
BILLING_DISABLED=true

# Billing provider: stripe or polar (ignored when BILLING_DISABLED=true)
BILLING_PROVIDER=stripe

# Stripe (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Polar (required when BILLING_PROVIDER=polar)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_ANNUAL=

# AI Providers (at least one required; OpenAI or Mistral)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@trackedyourfuture.com
CONTACT_EMAIL=support@trackedyourfuture.com
# Set to "true" to deliver real email in development (otherwise dev logs to console)
EMAIL_DEV_SEND=false

# Cron
CRON_SECRET=generate-with-openssl-rand-base64-32

# Cloudflare Turnstile (bot protection on auth forms)
# Both must be set in production for the challenge to be enforced; if unset,
# Turnstile is inert (widget hidden, server verification skipped).
# Dev/E2E test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# (always pass). Always-block secret: 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application-level encryption key for sensitive columns (form-field answers).
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key requires re-encrypting every row; plan accordingly.
DATA_ENCRYPTION_KEY=

# Seed (scripts/seed.mjs) demo account passwords. If left empty, a random
# password is generated and printed by the seed run. Never reuse these in production.
SEED_DEMO_PASSWORD=
SEED_PRO_PASSWORD=
