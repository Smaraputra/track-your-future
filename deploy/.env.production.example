# Domain
DOMAIN=yourdomain.com

# GitHub (for image pull)
GITHUB_REPOSITORY=your-github-username/track-your-future

# PostgreSQL
POSTGRES_USER=tyf
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=track_your_future

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=tyf-documents

# Redis
REDIS_PASSWORD=change-me-strong-password

# Seed on first deployment (set to true once, then remove)
SEED_ON_INIT=false
# Demo/Pro account passwords, used only when the seed runs (SEED_ON_INIT=true).
# Leave empty to auto-generate a random password that the seed prints.
SEED_DEMO_PASSWORD=
SEED_PRO_PASSWORD=

# App environment variables (used by app container via env_file)
# These override the compose-level environment block above

# Auth
AUTH_URL=https://yourdomain.com
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# MinIO (public URL for presigned URLs - must go through Caddy)
MINIO_PUBLIC_ENDPOINT=minio.yourdomain.com
MINIO_PUBLIC_USE_SSL=true

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# AI Providers (at least one required for AI features; OpenAI takes priority)
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Cron
CRON_SECRET=generate-with-openssl-rand-base64-32

# Cloudflare Turnstile (bot protection on auth forms)
# Set both to enforce the challenge; if unset, Turnstile is inert (widget hidden,
# server verification skipped). Create a widget in the Cloudflare dashboard.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application-level encryption key for sensitive columns (form-field answers).
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key requires re-encrypting every row; plan accordingly.
DATA_ENCRYPTION_KEY=
